\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newenvironment{CSLReferences}[2]%
  {\par\addvspace{#2\baselineskip}\noindent
   \renewcommand{\bibitem}[2][]{\item}%
   \list{}{\setlength{\leftmargin}{#1\parindent}%
           \setlength{\itemsep}{#2\baselineskip}%
           \setlength{\parsep}{0pt}}%
   \item\relax}%
  {\endlist\par}

\pagestyle{fancy}
\fancyhf{}
\fancyhead{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\thepage}
}

\renewcommand{\chaptername}{BAB}
\renewcommand{\thechapter}{\Roman{chapter}}
\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\renewcommand{\thesubsection}{\arabic{chapter}.\arabic{section}.\arabic{subsection}}

\titleformat{\chapter}[display]
  {\normalfont\bfseries\centering\fontsize{14}{18}\selectfont}
  {\chaptername\ \thechapter}{10pt}{\fontsize{14}{18}\selectfont}
\titlespacing*{\chapter}{0pt}{10pt}{20pt}

\renewcommand{\cftchappresnum}{BAB }
\renewcommand{\cftchapnumwidth}{5em}
\cftsetindents{section}{0em}{3em}
\cftsetindents{subsection}{3em}{3.5em}
\renewcommand{\cftdotsep}{1}

\titleformat{\section}
  {\normalfont\bfseries\normalsize}{\thesection}{0.5em}{}

\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}{\thesubsection}{0.5em}{}

\onehalfspacing
\setlength{\parindent}{1.5cm}

\renewcommand{\contentsname}{DAFTAR ISI}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\setlength{\cftbeforechapskip}{5pt}
\makeatletter
\renewcommand{\@cftmaketoctitle}{%
  \@cftpagestyle
  \@afterheading}
\makeatother

\renewcommand{\arraystretch}{1.2}
\setlength{\tabcolsep}{4pt}
\let\oldtabular\tabular
\renewcommand{\tabular}{\footnotesize\oldtabular}
\AtBeginEnvironment{longtable}{\footnotesize}
\sloppy
\renewcommand{\texttt}[1]{{\ttfamily\hyphenchar\font=45\relax #1}}

\lstset{
  basicstyle=\footnotesize\ttfamily,
  breaklines=true,
  frame=single,
  numbers=left,
  numberstyle=\tiny,
  tabsize=2,
  captionpos=b,
  backgroundcolor=\color{lightgray!10},
  frame=single,
  rulecolor=\color{lightgray},
}

\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=blue,
  citecolor=black,
}

