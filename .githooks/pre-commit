#!/usr/bin/env bash
set -e

echo "=== Pre-commit: Validasi Laporan Generator ==="

# Cek dependensi
command -v pandoc >/dev/null 2>&1 || { echo "FAIL: pandoc tidak ditemukan"; exit 1; }
command -v pdflatex >/dev/null 2>&1 || { echo "FAIL: pdflatex tidak ditemukan"; exit 1; }

# Cek file wajib ada
for f in cover.md template.latex metadata.yml references.bib; do
  [ -f "$f" ] || { echo "FAIL: $f tidak ditemukan"; exit 1; }
done

# Coba build
echo "Build PDF..."
./build.sh

# Validasi output
[ -f Laporan.pdf ] || { echo "FAIL: Laporan.pdf tidak dihasilkan"; exit 1; }
SIZE=$(stat -c%s Laporan.pdf)
[ "$SIZE" -gt 50000 ] || { echo "FAIL: Laporan.pdf terlalu kecil ($SIZE bytes)"; exit 1; }

echo "=== Pre-commit: OK ==="
